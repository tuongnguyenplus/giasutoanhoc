# --- Máy chủ ---
PORT=3000
# Mã truy cập cho gia đình (bật khi đưa lên Internet; để trống = không cần mã)
ACCESS_CODE=
# Địa chỉ công khai của ứng dụng (dùng cho đường link trong báo cáo)
APP_URL=http://localhost:3000
# Thư mục lưu CSDL SQLite và ảnh bài làm
DATA_DIR=./data

# --- AI (Claude) — ra đề, chấm bài tự luận qua ảnh, giảng giải ---
# Không có khóa: ứng dụng chạy chế độ offline (bộ sinh bài + chấm theo đáp số cuối).
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# AI_MODE=off

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Với Gmail: dùng "Mật khẩu ứng dụng" (App Password), không dùng mật khẩu đăng nhập
SMTP_PASS=
SMTP_FROM="Gia sư Toán <ban@gmail.com>"

# --- Zalo Official Account ---
# Cách 1: access token cố định (hết hạn sau ~25 giờ)
ZALO_OA_ACCESS_TOKEN=
# Cách 2 (khuyên dùng): tự làm mới token
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REFRESH_TOKEN=
